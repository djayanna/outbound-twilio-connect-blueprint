# ─────────────────────────────────────────────────────────────────────────────
#  REQUIRED — you fill these in before running `make dev` or provision.py
# ─────────────────────────────────────────────────────────────────────────────

# ─── Twilio account credentials ──────────────────────────────────────────────
# From https://console.twilio.com → Account → API keys & tokens.
# All four are needed: Auth Token drives webhook signature validation on the
# scheduler + event-ingestor; API Key/Secret are what the TAC SDK's
# TACConfig.from_env() requires on construction (agent-connect won't boot
# without them).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=

# E.164 outbound caller ID. Must be a number you own on this account.
TWILIO_PHONE_NUMBER=+15550000000

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Required for real conversations. If left blank, agent-connect's
# on_message_ready returns a stub reply so the plumbing still works.
OPENAI_API_KEY=

# ─── Public URLs — Twilio must reach your laptop ─────────────────────────────
# Start `ngrok start --all --config ngrok.yml` first, then paste the three
# hostnames from the ngrok dashboard here. Each maps 1:1 to a tunnel in
# ngrok.yml (addr: 3001, 3002, 3003).
#
# TWILIO_VOICE_PUBLIC_DOMAIN:  no scheme (code adds https://)   → tunnel  3002
# SCHEDULER_PUBLIC_URL:        with scheme                      → tunnel  3001
# EVENT_INGESTOR_PUBLIC_URL:   with scheme                      → tunnel  3003
#
# Free-tier ngrok rotates these on every restart. Update here AND re-run
# `scripts/provision.py --force` so the Event Streams sink's destination
# URL gets refreshed.
TWILIO_VOICE_PUBLIC_DOMAIN=your-agent.ngrok.app
SCHEDULER_PUBLIC_URL=https://your-scheduler.ngrok.app
EVENT_INGESTOR_PUBLIC_URL=https://your-events.ngrok.app


# ─────────────────────────────────────────────────────────────────────────────
#  PROVISIONED — leave blank; `scripts/provision.py` writes these for you
# ─────────────────────────────────────────────────────────────────────────────
# The script is idempotent: existing SIDs are reused, missing ones are
# created. Pass --force to recreate everything.

TWILIO_MEMORY_STORE_ID=
TWILIO_CONVERSATION_CONFIGURATION_ID=
TWILIO_INTELLIGENCE_CONFIGURATION_ID=
TWILIO_EVENT_STREAMS_SINK_SID=
TWILIO_EVENT_STREAMS_SUBSCRIPTION_SID=


# ─────────────────────────────────────────────────────────────────────────────
#  OPTIONAL — safe defaults; change only when you need to
# ─────────────────────────────────────────────────────────────────────────────

# ─── Dev switches ────────────────────────────────────────────────────────────
# DEV_MODE=1 bypasses the X-Blueprint-Key header check on scheduler writes
# AND the Twilio-signature check on event-ingestor when TWILIO_AUTH_TOKEN
# is empty. Set to 0 (or unset) in production.
DEV_MODE=1

# ─── Inter-service URLs — only change for Docker / multi-host ────────────────
AGENT_CONNECT_URL=http://localhost:3002
SCHEDULER_URL=http://localhost:3001

# ─── LLM tuning ──────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini

# ─── Local storage ───────────────────────────────────────────────────────────
AUDIT_DB_PATH=./data/audit.db
JOBS_DB_PATH=./data/jobs.db
# Scheduler's local mirror of Orchestrator conversations (wallboard transcript).
CONVERSATIONS_DB_PATH=./data/conversations.db

# ─── Scheduler tunables ──────────────────────────────────────────────────────
# Dedupe window: refuse the same (scenario, to) pair within this many seconds.
DEDUPE_WINDOW_SECONDS=3600
# Max concurrent runs per scenario; set 0 to disable the cap.
CONCURRENCY_PER_SCENARIO=10

# ─── Auth + upstream callbacks (set in production) ───────────────────────────
# Shared secret that upstream clients send as X-Blueprint-Key on POST /jobs,
# POST /dnc, DELETE /dnc/{phone}, POST /internal/events. Unset + DEV_MODE=1
# is bypass; unset + DEV_MODE=0 is a hard 500.
BLUEPRINT_API_KEY=

# HMAC-SHA256 secret for signing POSTs to each Job's upstream_callback_url.
# Downstream verifies via X-Blueprint-Signature header over the raw body.
UPSTREAM_CALLBACK_SIGNING_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
# OTLP HTTP endpoint (e.g. http://localhost:4318) for exporting traces.
# Leave blank to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=voice-blueprint
