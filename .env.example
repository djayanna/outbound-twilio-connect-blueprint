# ─── Twilio account credentials ────────────────────────────────────────────────
# From https://console.twilio.com → Account → API keys & tokens.
# Auth Token is fine for the quickstart; use an API Key + Secret in production.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# E.164 outbound caller ID. Must be a number you own on this account.
TWILIO_PHONE_NUMBER=+15550000000

# ─── Twilio resources (populated by `uv run python scripts/provision.py`) ─────
TWILIO_MEMORY_STORE_ID=
TWILIO_CONVERSATION_CONFIGURATION_ID=
TWILIO_INTELLIGENCE_CONFIGURATION_ID=
TWILIO_EVENT_STREAMS_SINK_SID=

# ─── Public URLs for Twilio → your laptop ─────────────────────────────────────
# Set by ngrok (see ngrok.yml). agent-connect handles voice webhooks + the
# ConversationRelay WebSocket; event-ingestor receives Event Streams; the
# scheduler receives per-call/per-message StatusCallbacks.
TWILIO_VOICE_PUBLIC_DOMAIN=your-agent.ngrok.app
EVENT_INGESTOR_PUBLIC_URL=https://your-events.ngrok.app
SCHEDULER_PUBLIC_URL=https://your-scheduler.ngrok.app

# ─── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Inter-service URLs (defaults match the Procfile) ─────────────────────────
AGENT_CONNECT_URL=http://localhost:3002
SCHEDULER_URL=http://localhost:3001

# ─── Local storage ────────────────────────────────────────────────────────────
AUDIT_DB_PATH=./data/audit.db
JOBS_DB_PATH=./data/jobs.db

# ─── Observability ────────────────────────────────────────────────────────────
# Optional. Point at any OTLP HTTP endpoint (e.g. http://localhost:4318) to
# export traces. Leave blank to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=voice-blueprint

# ─── Dev switches ─────────────────────────────────────────────────────────────
# When set to "1", event-ingestor accepts unsigned Twilio webhooks. Never set
# in production.
DEV_MODE=1
